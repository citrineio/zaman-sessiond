[Unit]
Description=Zaman full-screen system menu
Requires=zaman-sessiond.service
After=zaman-sessiond.service

[Service]
Type=dbus
BusName=com.kawnelectro.Zaman.Menu1
ExecStart=/usr/libexec/zaman-menu
Environment=SDL_VIDEODRIVER=wayland
Restart=on-failure
RestartSec=1

# The graphical-session launcher starts this unit only after importing
# WAYLAND_DISPLAY and XDG_RUNTIME_DIR into the user systemd manager.
