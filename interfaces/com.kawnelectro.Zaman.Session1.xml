<?xml version="1.0" encoding="UTF-8"?>
<node name="/com/kawnelectro/Zaman/Session1">
  <interface name="com.kawnelectro.Zaman.Session1">
    <method name="Launch">
      <arg name="system_id" type="s" direction="in"/>
      <arg name="rom_path" type="s" direction="in"/>
    </method>
    <method name="StartTransfer">
      <arg name="menu_generation" type="t" direction="in"/>
      <arg name="generation" type="t" direction="out"/>
    </method>
    <method name="TransferContext">
      <arg name="generation" type="t" direction="out"/>
      <arg name="phase" type="s" direction="out"/>
    </method>
    <method name="TransferPresented"><arg name="generation" type="s" direction="in"/></method>
    <signal name="TransferInput">
      <arg name="generation" type="t"/>
      <arg name="event" type="s"/>
      <arg name="value" type="d"/>
    </signal>
    <method name="Stop"/>
    <method name="OpenMenu"/>
    <method name="CloseMenu"/>
    <method name="ToggleMenu"/>
    <method name="Resume"/>
    <method name="ExitGame"/>
    <method name="Shutdown"/>
    <method name="Reboot"/>
    <method name="GameState"><arg name="game_state" type="s" direction="out"/></method>
    <method name="MenuContext">
      <arg name="open" type="b" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="return_target" type="s" direction="out"/>
      <arg name="game_state" type="s" direction="out"/>
      <arg name="pending" type="b" direction="out"/>
      <arg name="error" type="s" direction="out"/>
      <arg name="allowed_actions" type="as" direction="out"/>
    </method>
    <method name="RequestMenuAction">
      <arg name="generation" type="t" direction="in"/>
      <arg name="action" type="s" direction="in"/>
    </method>
    <signal name="MenuContextChanged"><arg name="generation" type="t"/></signal>
    <method name="Status">
      <arg name="state" type="s" direction="out"/>
      <arg name="system_id" type="s" direction="out"/>
      <arg name="emulator_id" type="s" direction="out"/>
      <arg name="rom_path" type="s" direction="out"/>
      <arg name="last_result" type="s" direction="out"/>
      <arg name="last_error" type="s" direction="out"/>
    </method>
    <method name="Version">
      <arg name="version" type="s" direction="out"/>
    </method>
    <method name="MenuStatus">
      <arg name="open" type="b" direction="out"/>
      <arg name="generation" type="t" direction="out"/>
      <arg name="reason" type="s" direction="out"/>
    </method>
    <method name="ForegroundStatus">
      <arg name="foreground" type="s" direction="out"/>
      <arg name="return_target" type="s" direction="out"/>
      <arg name="reason" type="s" direction="out"/>
    </method>
    <method name="MenuPresented">
      <arg name="generation" type="t" direction="in"/>
    </method>
    <signal name="MenuOpened">
      <arg name="generation" type="t"/>
      <arg name="reason" type="s"/>
    </signal>
    <signal name="MenuClosed">
      <arg name="generation" type="t"/>
      <arg name="reason" type="s"/>
    </signal>
    <signal name="MenuInput">
      <arg name="generation" type="t"/>
      <arg name="event" type="s"/>
      <arg name="value" type="d"/>
    </signal>
  </interface>
</node>
