import QtQuick

// Exact owner-supplied sign PNG. Preserve its colors, transparency and aspect.
Image {
    objectName: "brandImage"
    source: "data:image/png;base64,"
    fillMode: Image.PreserveAspectFit
    smooth: true
    mipmap: true
    onStatusChanged: if (status === Image.Error) console.warn("Dukkan sign failed to decode")
}
