#!/usr/bin/env bash
# On-demand display debugging over the kiosk's Tailscale IPv4 address.
set -Eeuo pipefail

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
usage() {
    printf 'Usage: %s [start|stop|status|logs] [OUTPUT]\n' "${0##*/}"
    printf 'Default: start HDMI-A-1 on the Tailscale address, port 5900, 15 FPS.\n'
}
[[ $(id -u) -ne 0 ]] || die 'Run as the kiosk user, not root.'
action=${1:-start}
unit=zaman-debug-stream.service
for program in systemctl; do command -v "$program" >/dev/null || die "Missing command: $program"; done
case $action in
    stop) [[ $# -le 1 ]] || { usage; exit 2; }; systemctl --user stop "$unit"; exit ;;
    status) [[ $# -le 1 ]] || { usage; exit 2; }; systemctl --user status --no-pager "$unit"; exit ;;
    logs) [[ $# -le 1 ]] || { usage; exit 2; }; exec journalctl --user -u "$unit" -n 80 --no-pager ;;
    -h|--help|help) usage; exit ;;
    start) [[ $# -le 2 ]] || { usage; exit 2; } ;;
    *) usage; exit 2 ;;
esac

for program in systemd-run tailscale wayvnc ss; do
    command -v "$program" >/dev/null || die "Missing command: $program (install it yourself before starting the stream)."
done
if systemctl --user is-active --quiet "$unit"; then
    printf 'Display streaming is already running. Use %s status or stop.\n' "$0"
    exit 0
fi

# Read only known values; never source/eval the user manager's environment.
# Prefer its current graphical session values over possibly stale SSH exports.
manager_environment=$(systemctl --user show-environment)
stream_runtime=
stream_wayland=
stream_swaysock=
while IFS= read -r assignment; do
    case $assignment in
        XDG_RUNTIME_DIR=*) stream_runtime=${assignment#*=} ;;
        WAYLAND_DISPLAY=*) stream_wayland=${assignment#*=} ;;
        SWAYSOCK=*) stream_swaysock=${assignment#*=} ;;
    esac
done <<< "$manager_environment"
stream_runtime=${stream_runtime:-/run/user/$(id -u)}
[[ -d $stream_runtime ]] || die "Missing runtime directory: $stream_runtime"
[[ -n $stream_wayland ]] || die 'No WAYLAND_DISPLAY imported. Start the graphical session first.'
case $stream_wayland in /*) display_socket=$stream_wayland ;; *) display_socket=$stream_runtime/$stream_wayland ;; esac
[[ -S $display_socket ]] || die "The imported Wayland socket is not available: $display_socket"

stream_ip=$(tailscale ip -4) || die 'Cannot obtain the Tailscale IPv4 address.'
[[ $stream_ip =~ ^100\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || die 'No Tailscale IPv4 address is available.'
stream_output=${2:-HDMI-A-1}
[[ -n $stream_output && $stream_output != -* ]] || die 'Invalid output name.'
stream_fps=${ZAMAN_STREAM_FPS:-15}
stream_port=${ZAMAN_STREAM_PORT:-5900}
[[ $stream_fps =~ ^[0-9]{1,3}$ ]] && (( 10#$stream_fps >= 1 && 10#$stream_fps <= 120 )) || die 'ZAMAN_STREAM_FPS must be 1–120.'
[[ $stream_port =~ ^[0-9]{1,5}$ ]] && (( 10#$stream_port >= 1 && 10#$stream_port <= 65535 )) || die 'ZAMAN_STREAM_PORT must be 1–65535.'
stream_fps=$((10#$stream_fps))
stream_port=$((10#$stream_port))
if [[ -n $(ss -H -ltn "sport = :$stream_port") ]]; then
    die "Port $stream_port is already listening. Stop the existing stream or choose ZAMAN_STREAM_PORT."
fi

# Optional Sway readback validates the connector; other wlroots sessions can
# still use the same WayVNC command without Sway IPC.
if [[ -n $stream_swaysock ]] && command -v swaymsg >/dev/null && command -v python3 >/dev/null; then
    stream_outputs=$(SWAYSOCK="$stream_swaysock" swaymsg -r -t get_outputs) || die 'Cannot query the imported Sway session.'
    python3 -c 'import json,sys; name=sys.argv[1]; sys.exit(0 if any(o.get("name")==name and o.get("active") for o in json.load(sys.stdin)) else 1)' "$stream_output" <<< "$stream_outputs" || die "Output $stream_output is not active."
fi

systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
systemd-run --user --quiet --collect --unit="$unit" --service-type=exec \
    --expand-environment=no --description='Zaman on-demand display debugging' \
    --setenv="XDG_RUNTIME_DIR=$stream_runtime" --setenv="WAYLAND_DISPLAY=$stream_wayland" \
    -- "$(command -v wayvnc)" -v -R -r -o "$stream_output" -f "$stream_fps" "$stream_ip" "$stream_port"

# Type=exec verifies execution, not a ready VNC listener. Confirm readiness
# before reporting success; background service logs retain startup failures.
for attempt in {1..30}; do
    if ! systemctl --user is-active --quiet "$unit"; then
        journalctl --user -u "$unit" -n 30 --no-pager >&2
        die 'WayVNC exited before the stream became ready.'
    fi
    listeners=$(ss -H -ltn "sport = :$stream_port")
    if [[ $listeners == *"$stream_ip:$stream_port"* ]]; then
        printf 'Streaming %s at %s:%s (%s FPS). SSH is free.\n' "$stream_output" "$stream_ip" "$stream_port" "$stream_fps"
        printf 'Stop: %s stop\nLogs: %s logs\n' "$0" "$0"
        exit 0
    fi
    sleep 0.1
done
systemctl --user stop "$unit"
journalctl --user -u "$unit" -n 30 --no-pager >&2
die 'WayVNC did not open its Tailscale listener within three seconds.'
