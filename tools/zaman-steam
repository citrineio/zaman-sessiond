#!/usr/bin/env bash
set -euo pipefail

root="$HOME/.local/share/Steam"
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export DISPLAY="${DISPLAY:-:0}"
export LD_LIBRARY_PATH="$root/steamrtarm64:$root/steamrtarm64/video"

mkdir -p "$HOME/.local/state/zaman"
# BEGIN ZAMAN STEAM STARTUP TOAST v1
if ! python3 - <<'ZAMAN_STEAM_STARTUP_TOAST_PY'
import json
import os
from pathlib import Path
import re
import socket

def startup_event(proc=Path('/proc'), environ=os.environ):
    invocation = environ.get('INVOCATION_ID', '')
    if not re.fullmatch('[a-fA-F0-9]{32}', invocation):
        return None
    if not environ.get('XDG_RUNTIME_DIR'):
        return None
    if 'zaman-store-steam.service' not in (proc / 'self/cgroup').read_text():
        return None
    for process in proc.iterdir():
        if not process.name.isdigit():
            continue
        try:
            if process.stat().st_uid == os.getuid() and (process / 'comm').read_text().strip().lower() in ('steam', 'steamwebhelper'):
                return None
        except (FileNotFoundError, ProcessLookupError):
            pass
    return {'action': 'event', 'source': 'Zaman',
            'key': 'steam:launch:' + invocation.lower(),
            'title': 'Launching Steam', 'body': 'This may take a while.',
            'category': 'system'}

def emit_startup():
    try:
        event = startup_event()
        if event is None:
            return
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(0.15)
            connection.connect(str(Path(os.environ['XDG_RUNTIME_DIR']) / 'zaman-notifications/control.sock'))
            connection.sendall((json.dumps(event) + '\n').encode())
            connection.recv(256)
    except (OSError, ValueError):
        pass

if __name__ == '__main__':
    emit_startup()
ZAMAN_STEAM_STARTUP_TOAST_PY
then
    :
fi
# END ZAMAN STEAM STARTUP TOAST v1
exec /usr/bin/setpriv --inh-caps=-all --ambient-caps=-all -- "$root/steamrtarm64/steam" -noverifyfiles -bigpicture \
  >> "$HOME/.local/state/zaman/steam.log" 2>&1
